# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ─── Compiled output ─────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out
/build

# ─── Node ────────────────────────────────────────────────────
/node_modules
package-lock.json
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml

# ─── Angular-specific ────────────────────────────────────────
.angular/
.angular/cache
/coverage

# ─── Environment files ───────────────────────────────────────
src/environments/*.ts
!src/environments/environment.ts

# ─── IDEs and editors ────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ─── Visual Studio Code ──────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── Miscellaneous ───────────────────────────────────────────
.history/
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
typings/
*.tmp
*.log
*.gz
*.tgz
*.zip

# ─── System files ────────────────────────────────────────────
.DS_Store
Thumbs.db
